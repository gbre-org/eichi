# eichi configuration file.
#
# Copy to one of:
#   - $EICHI_CONFIG (any path you point the env var at)
#   - $XDG_CONFIG_HOME/eichi/eichi.toml
#   - ~/.config/eichi/eichi.toml
#
# The file is OPTIONAL — `eichi index <path>` works without it. The config
# is useful if you want a single canonical list of corpora to reindex on a
# schedule (e.g. from cron). A simple wrapper script can iterate over the
# corpora and call `eichi index` per entry.
#
# Each [[corpus]] block declares either:
#   - a filesystem root (``path = ...``, ``extensions = [...]``), OR
#   - a built-in connector by ``name = "claude-jsonl"`` or
#     ``name = "claude-watch-queue"``, OR
#   - any ``name`` plus ``connector = "http-conversation"`` (generic
#     HTTP/JSON conversation source; declare as many as you like) — see
#     below.

# Filesystem corpora (walked by `eichi index <path>`).
[[corpus]]
name = "notes"
path = "~/Documents/notes"
extensions = ["md", "txt"]

[[corpus]]
name = "code-readmes"
path = "~/repos"
extensions = ["md"]

# Claude Code session JSONL transcripts — invoke via
# `eichi index --corpus claude-jsonl`. Defaults to ~/.claude/projects
# when no path is set. Set ``path`` to override.
# [[corpus]]
# name = "claude-jsonl"
# path = "~/.claude/projects"

# claude-watch session-task queue items — invoke via
# `eichi index --corpus claude-watch-queue`. Defaults to
# ~/.config/session/queue.json. Set ``path`` to override.
# [[corpus]]
# name = "claude-watch-queue"
# path = "~/.config/session/queue.json"

# Generic conversation sources. ``name`` is the source tag the messages are
# indexed under, so each source can be searched on its own
# (``--source team-chat``) or together (``--source team-chat,support-inbox``).
# Everything backend-specific is config: endpoint, field mapping, auth and
# pagination. Index with `eichi index --corpus <name>`; the recurring
# reindex script picks up every block automatically. The hosts, ports and
# field names below are placeholders.
#
# [[corpus]]
# name = "team-chat"
# connector = "http-conversation"
# url = "http://chat.example.test:8080/api/messages"
# items_path = "messages"            # where the list lives in the response
# timestamp_format = "epoch"         # or "epoch_ms" / "iso8601"
# [corpus.fields]                    # dotted paths into each message
# id = "id"
# body = "body"
# author = "sender"
# timestamp = "ts"
# thread = "topic"
# reply_to = "reply_to"
# [corpus.pagination]
# mode = "before"                    # GET ...?limit=500&before=<oldest id>
#
# A second, differently-shaped source alongside it: bearer auth read from
# the environment, nested fields, page-number pagination, ISO timestamps.
# [[corpus]]
# name = "support-inbox"
# connector = "http-conversation"
# url = "https://helpdesk.example.test/v2/threads/export"
# items_path = "data.items"
# timestamp_format = "iso8601"
# [corpus.headers]
# Authorization = "Bearer ${SUPPORT_INBOX_TOKEN}"
# [corpus.fields]
# id = "uid"
# body = "content.text"
# author = "from.name"
# timestamp = "created_at"
# thread = "subject"
# [corpus.pagination]
# mode = "page"
# page_param = "p"
#
# A local JSON export works too: url = "file:///path/to/export.json"
# (use format = "jsonl" for one JSON object per line).
